{
  "manifest_version": 3,
  "name": "ChatGPT Limit Live",
  "version": "1.8.0",
  "minimum_chrome_version": "111",
  "description": "Automatically shows server-reported Work/Codex allowance on ChatGPT. Account-aware weekly and short-window meters.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "ChatGPT Limit Live",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "ui.js",
        "layout.js",
        "pill.js",
        "tooltip.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "homepage_url": "https://github.com/NasaatR/ChatGPT-Limit-Live"
}
